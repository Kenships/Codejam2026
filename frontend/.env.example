# Relay WebSocket URL. Must be wss:// when the site is served over HTTPS (Cloudflare Pages).
#   Local relay (cd relay && npm run dev):  ws://localhost:8080/
#   Deployed relay:                         wss://truehue-production.up.railway.app
# Put your own value in frontend/.env.local (ignored by git). Pages sets it as a build variable.
VITE_RELAY_URL=ws://localhost:8080/

# true = fake the relay so the UI can be clicked through offline (no WebSocket at all).
# Only works under `npm run dev`; production builds always use the real relay.
VITE_DEV_MOCK=false

# Not env vars, but useful URL parameters on the deployed site:
#   ?room=ABCD                pre-fills the room code on /join (Unity's QR code)
#   ?ws=wss://<other-relay>   use a different relay for this tab (Cloudflare Tunnel backup)
#   ?ws=                      forget that override
