<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Menu/Menu.uss" />
    <ui:VisualElement name="menu-root" class="menu-root">
        <PixelBlastBackground name="background" class="menu-background" pixel-size="10" pattern-density="4" glow="0.5" drift="0.1" hover-radius="50" ripple-thickness="0.4" />
        <ui:VisualElement name="column" class="menu-column">
            <ui:VisualElement name="header" class="menu-header">
                <ui:Label name="title" text="HUESLIDER" class="menu-title hue-text" />
                <ui:Label name="subtitle" text="Find the hue that matches the room" class="menu-subtitle hue-text" />
            </ui:VisualElement>
            <HueBar name="hue-bar" class="hue-border" />
            <ui:VisualElement name="card" class="card hue-border">
                <ui:Label name="card-title" text="JOIN A GAME" class="card-title hue-text" />
                <ui:Label name="card-description" text="Enter your username and the 4-letter room code" class="card-description hue-text" />
                <ui:VisualElement name="card-content" class="card-content">
                    <ui:TextField name="username" class="menu-input" />
                    <ui:TextField name="room-code" class="menu-input menu-input--room" />
                    <ui:Label name="error" class="card-error" />
                </ui:VisualElement>
                <ui:VisualElement name="card-footer" class="card-footer">
                    <ui:Button name="join" text="JOIN GAME" class="menu-button" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
