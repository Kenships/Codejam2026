<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Menu/Menu.uss?fileID=7433441132597879392&amp;guid=bd7b51021bae4fdebee2137e8b14dc06&amp;type=3#Menu"/>
    <ui:VisualElement name="menu-root" class="menu-root">
        <ui:VisualElement name="character-labels-layer" picking-mode="Ignore" class="character-labels-layer"/>
        <ui:VisualElement name="column" class="menu-column">
            <ui:VisualElement name="header" class="menu-header">
                <TrueHueTitle name="title" class="true-hue-title"/>
                <ui:Label name="subtitle" text="Find the hue that matches the room" class="menu-subtitle hue-text"/>
            </ui:VisualElement>
            <HueBar name="hue-bar" class="hue-border"/>

            <!-- Create Game View (Console Title Screen) -->
            <ui:VisualElement name="card" class="card card--create hue-border">
                <ui:Label name="card-title" text="CREATE A GAME" class="card-title hue-text"/>
                <ui:Label name="card-description" text="Open a game lobby on this screen for players to join with a 4-letter room code" class="card-description hue-dim-text"/>
                <ui:VisualElement name="card-content" class="card-content">
                    <ui:Label name="error" class="card-error"/>
                </ui:VisualElement>
                <ui:VisualElement name="card-footer" class="card-footer">
                    <ui:Button name="join" text="CREATE GAME" class="menu-button menu-button--primary"/>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Host Lobby Join Screen (Compact Center Card; Players Populate Around It Clockwise) -->
            <ui:VisualElement name="lobby-card" class="card card--lobby hue-border is-hidden">
                <ui:VisualElement name="lobby-header-row" class="lobby-header-row">
                    <ui:Label name="lobby-title" text="WAITING FOR PLAYERS..." class="lobby-title hue-text"/>
                    <ui:VisualElement name="player-count-badge" class="lobby-count-badge hue-border">
                        <ui:Label name="player-count" text="0 / 12" class="lobby-count-text hue-text"/>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="room-code-box" class="lobby-code-box hue-border">
                    <ui:VisualElement name="room-code-text" class="lobby-code-text">
                        <ui:Label name="room-code-label" text="ROOM CODE" class="lobby-code-label hue-dim-text"/>
                        <ui:Label name="room-code-display" text="KXQM" class="lobby-code-value hue-text"/>
                        <ui:Label name="room-join-site" class="lobby-join-site hue-dim-text is-hidden"/>
                    </ui:VisualElement>
                    <!-- Filled from RelayClient.JoinUrl; hidden until there's a real room -->
                    <ui:VisualElement name="room-qr-box" class="lobby-qr-box is-hidden">
                        <ui:VisualElement name="room-qr" class="lobby-qr"/>
                        <ui:Label name="room-qr-label" text="SCAN TO JOIN" class="lobby-qr-label hue-dim-text"/>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:Label name="lobby-description" text="Enter the 4-letter code on your device to join" class="lobby-description hue-dim-text"/>
                <ui:Label name="lobby-error" class="card-error"/>

                <ui:VisualElement name="lobby-footer" class="card-footer card-footer--lobby">
                    <ui:Button name="back-button" text="BACK" class="menu-button menu-button--secondary"/>
                    <ui:Button name="start-match" text="START MATCH" class="menu-button menu-button--primary"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
