/* Console / TV Host Menu & Lobby UI (1920x1080 16:9 reference resolution).
   World-space ColorBody cubes meander and merge in the background rendered by
   Main Camera, so .menu-root uses a transparent background. */

.menu-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    padding: 24px 36px;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(255, 255, 255);
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Jersey25-Regular.ttf");
}

.menu-root .menu-background {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    opacity: 0.35;
}

.menu-root .character-labels-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
}

/* Outer ring of seats in use (more than 12 players): smaller tags so neighbours don't overlap */
.menu-root .is-crowded .character-name-label {
    padding: 1px 6px;
    font-size: 17px;
    letter-spacing: 1px;
}

.menu-root .character-name-label {
    position: absolute;
    translate: -50% -50%;
    padding: 2px 10px;
    background-color: rgba(0, 0, 0, 0.72);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.45);
    font-size: 24px;
    -unity-font-style: bold;
    letter-spacing: 1.4px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    text-shadow: 0 0 10px rgb(0, 0, 0);
}

.menu-root .is-hidden {
    display: none;
}

/* Compact centered column so player character cubes have a clear ring around the join screen */
.menu-root .menu-column {
    width: 100%;
    max-width: 560px;
}

.menu-root .menu-column--lobby {
    max-width: 500px;
}

/* Lobby with a join link: lobby card (500) + gap (24) + QR panel (324) side by side.
   MenuController measures this column to keep the player cube ring clear of both panels. */
.menu-root .menu-column--lobby.menu-column--lobby-qr {
    max-width: 848px;
}

.menu-root .unity-label {
    margin: 0;
    padding: 0;
}

/* ---- Header ---- */

.menu-root .menu-header {
    align-items: center;
    margin-bottom: 18px;
}

.menu-root .menu-column--lobby .menu-header {
    margin-bottom: 10px;
}

.menu-root .menu-title {
    font-size: 112px;
    -unity-font-style: bold;
    letter-spacing: 5.5px;
    padding-left: 5.5px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    text-shadow: 0 0 24px rgb(0, 0, 0);
}

.menu-root .menu-column--lobby .menu-title {
    font-size: 76px;
    letter-spacing: 3.8px;
    padding-left: 3.8px;
}

/* Wider lobby (card + QR panel, 848px): scale the header up to match the panels' width.
   TrueHueTitle reads the resolved font size for its overlap shift, so the animation scales too. */
.menu-root .menu-column--lobby.menu-column--lobby-qr .menu-header {
    margin-bottom: 14px;
}

.menu-root .menu-column--lobby.menu-column--lobby-qr .menu-title {
    font-size: 132px;
    letter-spacing: 6px;
    padding-left: 6px;
}

.menu-root .menu-column--lobby.menu-column--lobby-qr .menu-subtitle {
    font-size: 30px;
    letter-spacing: 1px;
}

.menu-root .menu-column--lobby.menu-column--lobby-qr .hue-bar {
    height: 18px;
    margin-bottom: 16px;
}

.menu-root .true-hue-title {
    align-items: center;
    justify-content: center;
}

.menu-root .true-hue-title__animated {
    flex-direction: row;
    align-items: baseline;
    justify-content: center;
}

.menu-root .true-hue-title__letter {
    letter-spacing: 1px;
    padding-left: 0;
}

.menu-root .true-hue-title__rh-slot {
    position: relative;
    flex-direction: row;
    align-items: baseline;
}

.menu-root .true-hue-title__r {
    position: absolute;
    left: 0;
    top: 0;
}

.menu-root .menu-subtitle {
    font-size: 26px;
    letter-spacing: 0.8px;
    -unity-text-align: middle-center;
    white-space: normal;
    text-shadow: 0 0 14px rgb(0, 0, 0);
}

.menu-root .menu-column--lobby .menu-subtitle {
    font-size: 20px;
}

/* ---- Hue bar ---- */

.menu-root .hue-bar {
    height: 16px;
    width: 100%;
    margin-bottom: 18px;
    border-width: 2px;
    border-color: rgb(255, 255, 255);
    background-color: rgb(255, 255, 255);
}

.menu-root .menu-column--lobby .hue-bar {
    height: 14px;
    margin-bottom: 12px;
}

.menu-root .hue-bar__handle {
    position: absolute;
    top: -3px;
    bottom: -3px;
    width: 18px;
    translate: -50% 0;
    background-color: rgb(255, 255, 255);
    border-width: 2px;
    border-color: rgb(15, 15, 15);
    border-radius: 3px;
}

/* ---- Card Base ---- */

.menu-root .card {
    background-color: rgba(0, 0, 0, 0.82);
    border-width: 2px;
    border-color: rgb(255, 255, 255);
}

.menu-root .card--create {
    padding: 40px 44px;
    align-items: center;
}

.menu-root .card--lobby {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    padding: 24px 32px 26px 32px;
    align-items: center;
    justify-content: center;
}

/* Separate QR panel to the right of the lobby card, stretched to the same height */
.menu-root .card--qr {
    flex-shrink: 0;
    margin-left: 24px;
    padding: 20px 28px 24px 28px;
    align-items: center;
    justify-content: center;
}

.menu-root .card-title {
    font-size: 40px;
    -unity-font-style: bold;
    letter-spacing: 2.2px;
    padding-left: 2.2px;
    -unity-text-align: middle-center;
    margin-bottom: 8px;
    text-shadow: 0 0 12px rgb(0, 0, 0);
}

.menu-root .card-description {
    font-size: 20px;
    max-width: 440px;
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 24px;
    text-shadow: 0 0 8px rgb(0, 0, 0);
}

.menu-root .card-content {
    width: 100%;
    align-items: center;
}

/* text-red-400 */
.menu-root .card-error {
    margin-bottom: 14px;
    font-size: 18px;
    color: rgb(248, 113, 113);
    -unity-text-align: middle-center;
    white-space: normal;
    text-shadow: 0 0 8px rgb(0, 0, 0);
}

/* ---- Create Game Settings (LABEL  [-] value [+]) ---- */

.menu-root .game-settings {
    width: 100%;
    max-width: 440px;
    margin-bottom: 24px;
}

.menu-root .setting-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
}

.menu-root .setting-label {
    font-size: 22px;
    letter-spacing: 1.8px;
    -unity-text-align: middle-left;
    text-shadow: 0 0 8px rgb(0, 0, 0);
}

.menu-root .setting-stepper {
    flex-direction: row;
    align-items: center;
}

.menu-root .setting-value {
    width: 76px;
    font-size: 26px;
    -unity-font-style: bold;
    letter-spacing: 1.2px;
    -unity-text-align: middle-center;
    text-shadow: 0 0 8px rgb(0, 0, 0);
}

/* Colours come from MenuController.RefreshButton (hue border/text, filled on hover) */
.menu-root .setting-step.unity-button {
    width: 40px;
    height: 40px;
    margin: 0;
    padding: 0;
    border-width: 2px;
    border-radius: 0;
    border-color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0.45);
    color: rgb(255, 255, 255);
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Jersey25-Regular.ttf");
}

/* ---- Buttons ---- */

.menu-root .card-footer {
    width: 100%;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.menu-root .card-footer--lobby {
    justify-content: space-between;
    margin-top: 4px;
}

.menu-root .menu-button.unity-button {
    min-width: 220px;
    height: 52px;
    margin: 0;
    padding: 8px 30px;
    border-width: 2px;
    border-radius: 0;
    border-color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0.45);
    color: rgb(255, 255, 255);
    font-size: 24px;
    -unity-font-style: bold;
    letter-spacing: 2.4px;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Jersey25-Regular.ttf");
}

.menu-root .menu-button--secondary.unity-button {
    min-width: 140px;
    height: 46px;
    padding: 6px 20px;
    font-size: 20px;
    letter-spacing: 1.8px;
}

.menu-root .card--lobby .menu-button--primary.unity-button {
    min-width: 220px;
    height: 46px;
    padding: 6px 24px;
    font-size: 22px;
}

/* ---- Host Lobby Center Join Card ---- */

.menu-root .lobby-view {
    width: 100%;
    align-items: center;
}

/* Lobby card + QR panel row; panels stretch to the taller one's height */
.menu-root .lobby-panels {
    width: 100%;
    flex-direction: row;
    align-items: stretch;
    justify-content: center;
}

.menu-root .lobby-header-row {
    width: 100%;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
}

.menu-root .lobby-title {
    font-size: 26px;
    -unity-font-style: bold;
    letter-spacing: 1.4px;
    -unity-text-align: middle-left;
    text-shadow: 0 0 12px rgb(0, 0, 0);
}

.menu-root .lobby-count-badge {
    padding: 4px 12px;
    border-width: 2px;
    border-color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0.55);
    align-items: center;
    justify-content: center;
}

.menu-root .lobby-count-text {
    font-size: 18px;
    -unity-font-style: bold;
    letter-spacing: 1.4px;
    white-space: nowrap;
}

.menu-root .lobby-code-box {
    width: 100%;
    padding: 12px 24px 14px 24px;
    margin-bottom: 12px;
    border-width: 2px;
    border-color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0.65);
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.menu-root .lobby-code-text {
    flex-grow: 1;
    flex-shrink: 1;
    align-items: center;
    justify-content: center;
}

.menu-root .qr-card-title {
    font-size: 30px;
    -unity-font-style: bold;
    letter-spacing: 2.4px;
    padding-left: 2.4px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    margin-bottom: 12px;
    text-shadow: 0 0 12px rgb(0, 0, 0);
}

/* QR plate: the ColorBody cube sprite (white, so MenuController tints it the picked hue);
   sized to be scannable from across a living room */
.menu-root .lobby-qr {
    flex-shrink: 0;
    width: 264px;
    height: 264px;
    background-image: url("project://database/Assets/Media/Rectangle%2016.png?fileID=2800000&guid=7ffe406af9b49a840aad9ecc5a83ea0c&type=3#Rectangle 16");
    -unity-background-scale-mode: scale-to-fit;
}

/* White-on-transparent QR mask over the plate, with its quiet zone baked in; MenuController
   tints it black or white, whichever reads on the plate's hue */
.menu-root .lobby-qr-code {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
}

/* Join site centred under both panels, large enough to read from the couch */
.menu-root .lobby-join-link {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 16px;
}

.menu-root .lobby-join-prefix {
    font-size: 24px;
    letter-spacing: 2px;
    padding-left: 2px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    margin-right: 14px;
    text-shadow: 0 0 10px rgb(0, 0, 0);
}

.menu-root .lobby-join-site {
    font-size: 42px;
    -unity-font-style: bold;
    letter-spacing: 1.6px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    text-shadow: 0 0 16px rgb(0, 0, 0);
}

.menu-root .lobby-code-label {
    font-size: 16px;
    letter-spacing: 2.8px;
    padding-left: 2.8px;
    -unity-text-align: middle-center;
    margin-bottom: 2px;
}

.menu-root .lobby-code-value {
    font-size: 64px;
    -unity-font-style: bold;
    letter-spacing: 10px;
    padding-left: 10px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    text-shadow: 0 0 18px rgb(0, 0, 0);
}

.menu-root .lobby-description {
    font-size: 19px;
    margin-bottom: 16px;
    -unity-text-align: middle-center;
    white-space: normal;
    text-shadow: 0 0 8px rgb(0, 0, 0);
}
