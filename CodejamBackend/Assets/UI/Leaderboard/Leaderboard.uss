/* Leaderboard after each drawing + winners podium at the end (1920x1080 reference).
   Translated from the frontend's components/ui/leaderboard-rankings.tsx and
   leaderboard-podium.tsx (Tailwind -> USS), in the game's pixel style:
     rank colours   --color-rank-1/2/3: #facc15 / #cbd5e1 / #d97706
     podium blocks  bg-rank-1/60, bg-rank-2/30, bg-rank-3/50, heights h-40 / h-32 / h-28 (scaled up)
     rows           flex items-center gap-2 px-4 py-2, divide-y, crown on ranks 1-3,
                    TrendingUp/Down rank change (success-600 / red-600), tabular value on the right
   Accent colours (.accent-*) and row positions are set from LeaderboardUI.cs. */

.lb-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Jersey25-Regular.ttf");
}

.lb-root .unity-label {
    margin: 0;
    padding: 0;
}

.lb-root.is-hidden,
.lb-root .is-hidden {
    display: none;
}

.lb-scrim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.62);
}

.lb-view {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    padding: 40px 0 36px 0;
    align-items: center;
    justify-content: space-between;
}

/* ---- Header ---- */

.lb-header {
    align-items: center;
}

.lb-kicker {
    font-size: 24px;
    letter-spacing: 3px;
    padding-left: 3px;
    -unity-text-align: middle-center;
    text-shadow: 0 0 12px rgb(0, 0, 0);
}

.lb-title {
    font-size: 76px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    padding-left: 4px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    text-shadow: 0 0 24px rgb(0, 0, 0);
}

.lb-title--big {
    font-size: 96px;
}

/* ---- Card + rows (leaderboard-rankings) ---- */

.lb-card {
    width: 880px;
    padding: 10px 0;
    background-color: rgba(0, 0, 0, 0.84);
    border-width: 2px;
    border-color: rgb(255, 255, 255);
}

/* Height is set from code (rows are positioned absolutely so they can slide) */
.lb-list {
    position: relative;
    width: 100%;
}

/* "+N MORE PLAYERS" under a list cut to the top N (LeaderboardUI.maxShownPlayers) */
.lb-more {
    font-size: 20px;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    margin-top: 8px;
}

.lb-row {
    position: absolute;
    left: 0;
    right: 0;
    flex-direction: row;
    align-items: center;
    padding: 0 26px;
    border-bottom-width: 1px;
    border-color: rgba(255, 255, 255, 0.14);
    opacity: 0;
    translate: -40px 0;
    transition-property: top, opacity, translate, background-color;
    transition-duration: 0.8s, 0.35s, 0.35s, 0.4s;
    transition-timing-function: ease-in-out-cubic, ease-out-cubic, ease-out-cubic, linear;
}

.lb-row.is-shown {
    opacity: 1;
    translate: 0 0;
}

.lb-row--rank-1 {
    background-color: rgba(250, 204, 21, 0.14);
}

.lb-row--rank-2 {
    background-color: rgba(203, 213, 225, 0.08);
}

.lb-row--rank-3 {
    background-color: rgba(217, 119, 6, 0.1);
}

/* "w-12": rank number + crown */
.lb-rank-cell {
    width: 96px;
    flex-direction: row;
    align-items: center;
}

.lb-rank-number {
    width: 42px;
    font-size: 34px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.lb-rank-1 {
    color: rgb(250, 204, 21);
}

.lb-rank-2 {
    color: rgb(203, 213, 225);
}

.lb-rank-3 {
    color: rgb(217, 119, 6);
}

.lb-crown {
    width: 34px;
    height: 34px;
}

/* "h-10 w-10" avatar, square to match the players' cubes */
.lb-avatar {
    width: 46px;
    height: 46px;
    margin-right: 18px;
    border-width: 3px;
    align-items: center;
    justify-content: center;
    -unity-background-scale-mode: scale-and-crop;
}

.lb-avatar-initial {
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.lb-name-col {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

.lb-name {
    font-size: 32px;
    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.lb-byline {
    font-size: 18px;
    letter-spacing: 1px;
    color: rgba(255, 255, 255, 0.6);
    white-space: nowrap;
}

/* TrendingUp / TrendingDown */
.lb-change {
    flex-direction: row;
    align-items: center;
    width: 66px;
    margin-right: 10px;
}

.lb-change-glyph {
    width: 20px;
    height: 20px;
    margin-right: 4px;
}

.lb-change-text {
    font-size: 22px;
    -unity-font-style: bold;
}

.lb-change--up {
    color: rgb(34, 197, 94);
}

.lb-change--down {
    color: rgb(220, 38, 38);
}

.lb-gain {
    width: 96px;
    margin-right: 14px;
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    color: rgb(74, 222, 128);
}

.lb-gain--zero {
    color: rgba(255, 255, 255, 0.35);
}

.lb-total {
    width: 130px;
    font-size: 38px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    white-space: nowrap;
}

/* ---- Winners (leaderboard-podium) ---- */

.lb-winners-body {
    flex-direction: row;
    align-items: flex-end;
    justify-content: center;
}

.lb-podium {
    flex-direction: row;
    align-items: flex-end;
    justify-content: center;
}

.lb-podium-slot {
    width: 230px;
    margin: 0 12px;
    align-items: center;
}

.lb-podium-slot--1 {
    width: 260px;
}

/* The big crown that drops onto each winner */
.lb-podium-crown-wrap {
    width: 96px;
    height: 84px;
    margin-bottom: 2px;
    opacity: 0;
    translate: 0 -140px;
    transition-property: opacity, translate;
    transition-duration: 0.3s, 0.65s;
    transition-timing-function: ease-out-cubic, ease-out-bounce;
}

.lb-podium-crown-wrap.is-shown {
    opacity: 1;
    translate: 0 0;
}

.lb-podium-crown {
    width: 100%;
    height: 100%;
}

.lb-podium-crown-spacer {
    height: 86px;
}

.lb-podium-person {
    align-items: center;
    opacity: 0;
    translate: 0 30px;
    transition-property: opacity, translate;
    transition-duration: 0.4s, 0.4s;
    transition-timing-function: ease-out-cubic, ease-out-cubic;
}

.lb-podium-person.is-shown {
    opacity: 1;
    translate: 0 0;
}

.lb-podium-avatar-wrap {
    margin-bottom: 10px;
}

.lb-podium-avatar {
    width: 116px;
    height: 116px;
    border-width: 4px;
    align-items: center;
    justify-content: center;
    -unity-background-scale-mode: scale-and-crop;
}

.lb-podium-slot--1 .lb-podium-avatar {
    width: 140px;
    height: 140px;
}

.lb-podium-avatar .lb-avatar-initial {
    font-size: 58px;
}

/* "bg-background absolute -right-1 -bottom-1" crown badge */
.lb-podium-badge {
    position: absolute;
    right: -12px;
    bottom: -12px;
    width: 44px;
    height: 44px;
    padding: 6px;
    background-color: rgb(0, 0, 0);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.3);
}

.lb-podium-name {
    max-width: 240px;
    font-size: 36px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    text-shadow: 0 0 12px rgb(0, 0, 0);
}

.lb-podium-points {
    font-size: 26px;
    -unity-text-align: middle-center;
    color: rgba(255, 255, 255, 0.7);
}

/* "mt-2 w-22 rounded-t-lg" block; grows up from the floor */
.lb-podium-block {
    width: 100%;
    margin-top: 12px;
    align-items: center;
    border-width: 2px;
    border-bottom-width: 0;
    transform-origin: bottom;
    scale: 1 0;
    transition-property: scale;
    transition-duration: 0.7s;
    transition-timing-function: ease-out-back;
}

.lb-podium-block.is-shown {
    scale: 1 1;
}

.lb-podium-block--1 {
    height: 270px;
    background-color: rgba(250, 204, 21, 0.6);
    border-color: rgb(250, 204, 21);
}

.lb-podium-block--2 {
    height: 210px;
    background-color: rgba(203, 213, 225, 0.3);
    border-color: rgb(203, 213, 225);
}

.lb-podium-block--3 {
    height: 170px;
    background-color: rgba(217, 119, 6, 0.5);
    border-color: rgb(217, 119, 6);
}

.lb-podium-rank {
    margin-top: 10px;
    font-size: 80px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    text-shadow: 0 0 14px rgb(0, 0, 0);
}

.lb-others-card {
    width: 520px;
    margin-left: 48px;
    padding: 12px 0 10px 0;
}

.lb-others-title {
    font-size: 20px;
    letter-spacing: 3px;
    padding-left: 26px;
    margin-bottom: 6px;
}

.lb-others-card .lb-row {
    padding: 0 18px;
}

.lb-others-card .lb-rank-cell {
    width: 56px;
}

.lb-others-card .lb-name {
    font-size: 28px;
}

.lb-others-card .lb-total {
    font-size: 30px;
    width: 110px;
}

/* ---- Footer ---- */

.lb-footer {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.lb-countdown {
    font-size: 22px;
    letter-spacing: 2px;
    margin-right: 22px;
    min-width: 260px;
    -unity-text-align: middle-right;
}

.lb-button.unity-button {
    min-width: 230px;
    height: 54px;
    margin: 0 10px;
    padding: 8px 26px;
    border-width: 2px;
    border-radius: 0;
    border-color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0.55);
    color: rgb(255, 255, 255);
    font-size: 24px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Jersey25-Regular.ttf");
    transition-property: background-color, scale;
    transition-duration: 0.15s, 0.15s;
}

.lb-button.unity-button:hover {
    background-color: rgba(255, 255, 255, 0.16);
    scale: 1.04 1.04;
}

.lb-button--primary.unity-button {
    border-width: 3px;
}
