<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Guessing/GuessingPhase.uss"/>
    <ui:VisualElement name="guessing-root" picking-mode="Ignore" class="guessing-root">

        <!-- Players who have guessed, seated clockwise around the card like the join screen
             (positioned by GuessingPhaseController via PlayerRingLayout) -->
        <ui:VisualElement name="guessed-icons-layer" picking-mode="Ignore" class="guessed-icons-layer"/>

        <!-- Artist + Black & White Drawing card, centred and sized to leave room for the player ring -->
        <ui:VisualElement name="guessing-layout" picking-mode="Ignore" class="guessing-layout">
            <ui:VisualElement name="guessing-card" class="guessing-card">
                <ui:VisualElement name="sidebar-top-row" class="sidebar-top-row">
                    <ui:VisualElement name="artist-row" class="artist-row">
                        <ui:VisualElement name="artist-cube" class="artist-cube">
                            <ui:VisualElement name="artist-pfp" class="artist-pfp"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="artist-text-col">
                            <ui:Label text="ARTIST" class="artist-kicker"/>
                            <ui:Label name="artist-name" text="PRISM" class="artist-name"/>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="sidebar-round-col">
                        <ui:Label name="round-label" text="DRAWING 1 / 4" class="sidebar-round-label"/>
                        <ui:VisualElement name="timer-badge" class="sidebar-timer-badge">
                            <ui:Label name="guess-timer" text="30s" class="sidebar-timer-text"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Free space the drawing is aspect-fitted and centred in (viewport sized from code) -->
                <ui:VisualElement name="drawing-area" picking-mode="Ignore" class="drawing-area">
                    <ui:VisualElement name="drawing-viewport" class="drawing-viewport">
                        <ui:VisualElement name="drawing-image" class="drawing-image"/>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:Label name="drawing-prompt" text="&quot;Golden hour sunset&quot;" class="drawing-prompt"/>

                <ui:VisualElement name="guess-footer" class="guess-footer">
                    <WaveText name="guess-count" text="0 / 3 GUESSED" animated-characters="." period="1.2" stagger="0.15" hop-duration="0.45" amplitude="0.28" class="guess-count"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Bottom Reveal Banner (Shown Once Guessed Cubes Merge Into a Singular Colour) -->
        <ui:VisualElement name="reveal-banner" class="reveal-banner is-hidden">
            <ui:VisualElement class="reveal-swatches-row">
                <ui:VisualElement class="reveal-swatch-col">
                    <ui:Label text="ROOM MERGED HUE" class="reveal-swatch-label"/>
                    <ui:VisualElement name="merged-swatch" class="reveal-swatch"/>
                    <ui:Label name="merged-hex" text="#FFFFFF" class="reveal-hex"/>
                </ui:VisualElement>

                <ui:VisualElement class="reveal-center-col">
                    <ui:Label name="match-percent" text="92% MATCH" class="reveal-match-percent"/>
                    <ui:Label name="reveal-subtitle" text="True Hue Revealed!" class="reveal-subtitle"/>
                    <ui:Button name="next-drawing" text="NEXT DRAWING" class="guessing-button guessing-button--next"/>
                </ui:VisualElement>

                <ui:VisualElement class="reveal-swatch-col">
                    <ui:Label text="TRUE HUE" class="reveal-swatch-label"/>
                    <ui:VisualElement name="target-swatch" class="reveal-swatch"/>
                    <ui:Label name="target-hex" text="#FF5733" class="reveal-hex"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Game Finished Overlay (Shown After All Drawings Are Complete) -->
        <ui:VisualElement name="finished-overlay" class="finished-overlay is-hidden">
            <ui:VisualElement class="finished-column">
                <TrueHueTitle name="finished-title" overlap-animate="true" class="true-hue-title"/>
                <ui:VisualElement name="finished-card" class="finished-card rainbow-border">
                    <ui:Label text="GAME COMPLETE!" class="finished-card-title rainbow-text"/>
                    <ui:Label name="finished-summary" text="All players' drawings have been guessed and revealed" class="finished-card-desc rainbow-dim-text"/>
                    <ui:VisualElement class="finished-footer">
                        <ui:Button name="back-to-menu" text="BACK TO MENU" class="guessing-button guessing-button--large"/>
                        <ui:Button name="play-again" text="PLAY AGAIN" class="guessing-button guessing-button--large"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
